{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "mkdir -p dist && cp -R assets dist/",
  "outputDirectory": "dist",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{index.php,componentes/**,datos/**,paginas/**}"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.php"
    }
  ]
}
